{:workflow/id :eng-017j-review
 :workflow/version 1

 :meta {:name "eng-017j-review"
        :description "Adversarial review of ENG-017J (mutation pilot + CI assurance evidence) before promotion."
        :phases [{:title "Review" :detail "3 lenses"}
                 {:title "Verify" :detail "2 skeptic votes per finding, quorum 2"}]}

 :run {:model "kimi-for-coding/k3"
       :dir "/home/err/spaces/epiphany"
       :agent-timeout-ms 900000
       :max-concurrency 3}

 :vars
 {:repo "/home/err/spaces/epiphany"
  :cards
  [{:key "eng-017j"
    :path "/home/err/spaces/epiphany/docs/kanban/stories/engineering-assurance-mutation-and-ci-evidence-pilot.md"
    :context "The change under review is commit d60e60a (ENG-017J: mutation pilot + CI assurance evidence artifact). Run `git show d60e60a` and read it. Key files: tools/epiphany/assurance_evidence.clj (+ alias :assurance-evidence), test/epiphany/law_suite/sabotage_test.clj (the two critical mutants), .github/workflows/test.yml (assurance-evidence job), docs/process/adversarial-case-handling.md (spec only), deps.edn (:heretic alias, retained but not CI-gated), heretic.edn. Documented decisions the reviewer must not re-litigate: heretic tool rejected FOR CI GATING as tool limitation (139+ CPU-min at scoped run) but alias retained locally; sabotage tests are the card's own sanctioned fallback path; adversarial-case companion repo + rotation are explicit follow-up recorded as gaps in the spec doc. Gates: clojure -M:unit-test => 743 tests, 2005 assertions, 0 failures. Try to break: the artifact schema dogfood (can a hand-edited artifact pass?), the seed recording (can seeds be lost silently?), the sabotage tests (do the mutants actually die for the RIGHT reason, or does the suite pass/fail for unrelated reasons?), the workflow job (does it actually produce+upload the artifact?)."}]
  :lenses
  [{:key "correctness"
    :prompt "Hunt for real correctness bugs: artifact generation that can silently produce empty/misleading evidence, seed log races or truncation, sabotage tests that pass for the wrong reason, workflow YAML that can't run, artifact schema holes a hand-edit can slip through."}
   {:key "architecture-law"
    :prompt "Audit against the repo constitution (AGENTS.md, ADR-004 esp. decision 7 'CI-generated evidence authoritative', dependency policy, zero-warning culture): is the artifact genuinely execution-generated? Is the heretic dep scoping honest (test alias only, not production)? Does the spec doc contradict ADR-004 §8? Cite the rule each finding violates."}
   {:key "dod-coverage"
    :prompt "Verify every acceptance criterion and verification-table row on the card against the actual code, tests, and workflow. Note the card's ACs were written for a full tool pilot — judge honestly whether the documented tool-limitation classification + sabotage fallback satisfies them, and flag any row with no evidence. Fill dodVerdict."}]}

 :schemas
 {:findings {:type "object"
             :additionalProperties false
             :properties {:findings {:type "array"
                                     :items {:type "object"
                                             :additionalProperties false
                                             :properties {:title {:type "string"}
                                                          :file {:type "string"}
                                                          :detail {:type "string" :description "What is wrong / unmet, with concrete evidence (line refs, failing scenario)"}
                                                          :severity {:type "string" :enum ["blocker" "should-fix" "nit"]}}
                                             :required ["title" "file" "detail" "severity"]}}
                          :dodVerdict {:type "string" :description "For dod-coverage lens only: per-DoD-item evidence table as text; empty string otherwise"}}
             :required ["findings" "dodVerdict"]}
  :verdict {:type "object"
            :additionalProperties false
            :properties {:refuted {:type "boolean" :description "true if the finding is wrong, already handled, out of scope for the card, or not worth acting on"}
                         :reason {:type "string"}}
            :required ["refuted" "reason"]}}

 :stages
 [{:stage/id :review
   :stage/kind :map-agent
   :stage/phase "Review"
   :stage/items {:cartesian [{:bind :card :from [:vars :cards]}
                             {:bind :lens :from [:vars :lenses]}]}
   :stage/agent "ultra-reviewer"
   :stage/schema :findings
   :stage/label "review:{card/key}:{lens/key}"
   :stage/prompt "You are reviewing a change in the repo ({repo}) against its kanban card.\n\nCard: read {card/path} in full (including comment history — earlier reviews may have already fixed things; do not re-report fixed items).\nRepo rules: read {repo}/AGENTS.md if present.\n{card/context}\n\nYour lens: {lens/prompt}\n\nRead the actual source files (and tests) relevant to your lens. Report ONLY findings that would matter to a maintainer deciding whether to promote this card. Do not report style preferences the repo doesn't legislate. If the dod-coverage lens, also fill dodVerdict with the per-item evidence table."}

  {:stage/id :verify
   :stage/kind :vote-fan-out
   :stage/phase "Verify"
   :stage/over :review
   :stage/finding-path [:findings]
   :stage/agent "ultra-skeptic"
   :stage/schema :verdict
   :stage/votes 2
   :stage/quorum 2
   :stage/label "verify:{finding/title|40}"
   :stage/prompt "A code reviewer claims the following about the repo ({repo}), card {card/path}:\n\nTITLE: {finding/title}\nFILE: {finding/file}\nCLAIM: {finding/detail}\nSEVERITY CLAIMED: {finding/severity}\n\nSkeptic pass #{vote/n}: try to REFUTE this. Read the actual code and card (including comment history — the card may already document this as an accepted tradeoff or fixed item). Refute if: the claim is factually wrong, the behavior is deliberate and documented, it is out of the card's delivered scope, or it is too minor to gate a promotion. Default to refuted=true if uncertain."}

  {:stage/id :return
   :stage/kind :return
   :stage/return {:confirmed :surviving :all :flat}}]}
