{:workflow/id :eng-017i-review
 :workflow/version 1

 :meta {:name "eng-017i-review"
        :description "Adversarial review of ENG-017I (generative + epistemic verification laws) before promotion."
        :phases [{:title "Review" :detail "3 lenses"}
                 {:title "Verify" :detail "2 skeptic votes per finding, quorum 2"}]}

 :run {:model "kimi-for-coding/k3"
       :dir "/home/err/spaces/epiphany"
       :agent-timeout-ms 900000
       :max-concurrency 3}

 :vars
 {:repo "/home/err/spaces/epiphany"
  :cards
  [{:key "eng-017i"
    :path "/home/err/spaces/epiphany/docs/kanban/stories/engineering-assurance-generative-epistemic-laws.md"
    :context "The change under review is commits e42564c + 77d636a (ENG-017I: generative and epistemic verification laws). Run `git show e42564c` and `git show 77d636a`. Key files: test/epiphany/law_suite/generators.clj (hand-curated test.check generators per write op, PRNG-pure UUIDs), test/epiphany/law_suite/generative_laws_test.clj (mutation/metamorphic/epistemic laws + coverage matrix), deps.edn (test.check added to TEST aliases only). Deliberate deferrals: no mutation-testing tooling (ENG-017J); no new outcome vocabulary (consumes ENG-017F's); malli.generator defaults deliberately not trusted for Git-evidence types (card's own risk note). Gates: clojure -M:unit-test => 737 tests, 1988 assertions, 0 failures. Your job: try to prove the properties VACUOUS (generators that can't produce interesting variance, mutations that can't distinguish, epistemic scenarios that can't actually collapse, coverage matrix with holes) or the seeds non-replayable."}]
  :lenses
  [{:key "correctness"
    :prompt "Hunt for vacuous or broken properties: generators producing invalid records (making mutation laws meaningless), PRNG leaks breaking seed replay, mutation laws that would pass even against a permissive adapter, metamorphic/epistemic scenarios that can't actually exercise the claimed collapse, coverage-matrix drift paths."}
   {:key "architecture-law"
    :prompt "Audit against the repo constitution (AGENTS.md, ADR-004, dependency policy, zero-warning culture): test.check scoping (test aliases only — verify nothing leaks into production :deps), test ns layering (test code may depend on law+domain+infra), dependency justification present. Cite the rule each finding violates."}
   {:key "dod-coverage"
    :prompt "Verify every acceptance criterion and verification-table row on the card against the actual code and tests, including the seed-replay demonstration in the card comments. Name the exact evidence per item, or flag it unmet."}]}

 :schemas
 {:findings {:type "object"
             :additionalProperties false
             :properties {:findings {:type "array"
                                     :items {:type "object"
                                             :additionalProperties false
                                             :properties {:title {:type "string"}
                                                          :file {:type "string"}
                                                          :detail {:type "string" :description "What is wrong / unmet, with concrete evidence (line refs, failing scenario)"}
                                                          :severity {:type "string" :enum ["blocker" "should-fix" "nit"]}}
                                             :required ["title" "file" "detail" "severity"]}}
                          :dodVerdict {:type "string" :description "For dod-coverage lens only: per-DoD-item evidence table as text; empty string otherwise"}}
             :required ["findings" "dodVerdict"]}
  :verdict {:type "object"
            :additionalProperties false
            :properties {:refuted {:type "boolean" :description "true if the finding is wrong, already handled, out of scope for the card, or not worth acting on"}
                         :reason {:type "string"}}
            :required ["refuted" "reason"]}}

 :stages
 [{:stage/id :review
   :stage/kind :map-agent
   :stage/phase "Review"
   :stage/items {:cartesian [{:bind :card :from [:vars :cards]}
                             {:bind :lens :from [:vars :lenses]}]}
   :stage/agent "ultra-reviewer"
   :stage/schema :findings
   :stage/label "review:{card/key}:{lens/key}"
   :stage/prompt "You are reviewing a change in the repo ({repo}) against its kanban card.\n\nCard: read {card/path} in full (including comment history — earlier reviews may have already fixed things; do not re-report fixed items).\nRepo rules: read {repo}/AGENTS.md if present.\n{card/context}\n\nYour lens: {lens/prompt}\n\nRead the actual source files (and tests) relevant to your lens. Report ONLY findings that would matter to a maintainer deciding whether to promote this card. Do not report style preferences the repo doesn't legislate. If the dod-coverage lens, also fill dodVerdict with the per-item evidence table."}

  {:stage/id :verify
   :stage/kind :vote-fan-out
   :stage/phase "Verify"
   :stage/over :review
   :stage/finding-path [:findings]
   :stage/agent "ultra-skeptic"
   :stage/schema :verdict
   :stage/votes 2
   :stage/quorum 2
   :stage/label "verify:{finding/title|40}"
   :stage/prompt "A code reviewer claims the following about the repo ({repo}), card {card/path}:\n\nTITLE: {finding/title}\nFILE: {finding/file}\nCLAIM: {finding/detail}\nSEVERITY CLAIMED: {finding/severity}\n\nSkeptic pass #{vote/n}: try to REFUTE this. Read the actual code and card (including comment history — the card may already document this as an accepted tradeoff or fixed item). Refute if: the claim is factually wrong, the behavior is deliberate and documented, it is out of the card's delivered scope, or it is too minor to gate a promotion. Default to refuted=true if uncertain."}

  {:stage/id :return
   :stage/kind :return
   :stage/return {:confirmed :surviving :all :flat}}]}
